nc = 4
nv = 7
compare = function(prefs,i,j){
pi = 0
pj = 0
for(k in 1:nv){
prefi = prefs[[k]][i]
prefj = prefs[[k]][j]
if(prefi < prefj){
pi = pi+1
}
if(prefj < prefi){
pj = pj+1
}
}
if(pi>pj){
win = i
lose = j
}
if(pj>pi){
win = j
lose = i
}
if(pj==pi){
win = 0
lose = 0
}
return(c(pi,pj,win,lose))
}
condorcet = function(prefs){
nv = length(prefs)
nc = length(prefs[[1]])
alwayswin = rep(T,nc)
for(i in 1:(nc-1)){
for(j in (i+1):nc){
pi = 0
pj = 0
for(k in 1:nv){
prefi = prefs[[k]][i]
prefj = prefs[[k]][j]
if(prefi < prefj){
pi = pi+1
}
if(prefj < prefi){
pj = pj+1
}
}
if(pi <= pj){
alwayswin[i] = F
}
if(pi >= pj){
alwayswin[j] = F
}
}
}
if(length(unique(alwayswin))==2){
return(which(alwayswin))
} else {
return(0)
}
}
plurality = function(prefs){
nv = length(prefs)
nc = length(prefs[[1]])
points = rep(0,nc)
for(k in 1:nv){
wo = which(prefs[[k]]==1)
points[wo] = points[wo]+1
}
mp = max(points)
if(sum(mp==points)==1){
return(which(points==mp))
} else {
return(0)
}
}
nocond = sample(c(T,F),1,F,c(1,nc))
while(T){
prefs = list()
for(i in 1:nv){
pref = sample(1:nc)
prefs[[i]] = pref
}
cond = condorcet(prefs)
plur = plurality(prefs)
if(cond!=0 && cond!=plur && nocond==F){
sol = paste0(1*(cond==1:(nc+1)),collapse="")
break
}
if(nocond==T && cond==0 && plur!=0){
sol = paste0(paste0(rep(0,nc),collapse=""),"1")
break
}
}
ach = c(LETTERS[26-nc+(1:nc)],"No Condorcet winner!")
al = paste0("* ",ach,collapse="\n")
cans = LETTERS[26-nc+(1:nc)]
